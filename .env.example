# Copy this file to .env and fill in your real OpenAI key.
# .env is gitignored — never commit real secrets.

OPENAI_API_KEY=sk-proj-your-key-here

# Chat generation model (production answers + eval dataset generation)
OPENAI_CHAT_MODEL=gpt-4o-mini
# Judge model (RAGAS scoring + OOD refusal judging)
OPENAI_JUDGE_MODEL=gpt-4o-mini
# Embedding model (chunking, quality gate, retrieval, RAGAS judge embeddings)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=chunks_collection

# Evaluation harness concurrency (APP/ragas_evaluation.py)
EVAL_CONCURRENCY=2
GEN_CONCURRENCY=2
