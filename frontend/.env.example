# Where the RAG backend lives. Must be NEXT_PUBLIC_ or it is stripped from the
# client bundle and every request silently goes to the wrong origin.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# When building for GitHub Pages or a shared Docker image, set this to the
# public backend origin you want the frontend to call.

# Public site origin used for the live site link in the header.
NEXT_PUBLIC_SITE_URL=https://vaibhavgit5048.github.io/Semantic-Question-Answering-over-Large-Documents-using-RAG-LLaMA-3-Ollama/

# Optional: override the GitHub Pages subpath. Leave unset for normal Pages
# deploys; set to an empty string when serving from a custom domain root.
# BASE_PATH=
