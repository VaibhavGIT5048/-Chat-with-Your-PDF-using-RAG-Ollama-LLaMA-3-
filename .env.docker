QDRANT_URL=http://qdrant:6333
# _v2 — bge-m3 (1024-dim) is the Phase 2 default embedding model, distinct
# from the old text-embedding-3-small (1536-dim) collection.
QDRANT_COLLECTION=chunks_collection_v2
API_URL=http://api:8000
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_JUDGE_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EVAL_CONCURRENCY=2
GEN_CONCURRENCY=2
